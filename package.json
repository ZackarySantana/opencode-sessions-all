{
  "name": "opencode-sessions-all",
  "version": "0.1.1",
  "description": "Cross-project session search and navigation for OpenCode",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "author": "ZackarySantana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZackarySantana/opencode-sessions-all.git"
  },
  "homepage": "https://github.com/ZackarySantana/opencode-sessions-all#readme",
  "bugs": {
    "url": "https://github.com/ZackarySantana/opencode-sessions-all/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "engines": {
    "bun": ">=1.4.3",
    "opencode": ">=2.1.1 <3"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test",
    "prepublishOnly": "bun run build && bun run test && bun run typecheck"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sessions",
    "search",
    "tui"
  ],
  "peerDependencies": {
    "@opencode/client": ">=2.1.1 <3",
    "@opencode/plugin": ">=2.1.1 <3",
    "@opentui/core": ">=0.6.6 <1",
    "@opentui/solid": ">=0.6.6 <1",
    "solid-js": ">=1.9.10 <2"
  },
  "devDependencies": {
    "@opencode/client": "2.1.1",
    "@opencode/plugin": "2.1.1",
    "@opencode/theme": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
